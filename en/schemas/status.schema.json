{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "status",
    "command",
    "result"
  ],
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_RUN"
      ]
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "result": {}
  }
}
