              "properties": {
                "commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "governance_commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "command": {
                  "type": "string",
                  "minLength": 1
                },
                "tool_versions": {
                  "type": "string",
                  "minLength": 1
                },
                "platform": {
                  "type": "string",
                  "minLength": 1
                },
                "observed_at": {
                  "type": "string",
                  "minLength": 1
                },
                "exit_code": {
                  "const": 0
                },
                "kind": {
                  "enum": ["review", "software", "clean_environment", "hardware", "publication"]
                },
                "result": {
                  "type": "string",
                  "pattern": "^en/references/evidence/"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "limits": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "minItems": 0,
            "uniqueItems": true
          }
        }
