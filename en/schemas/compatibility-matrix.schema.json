{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CIRNET Remote-owned exact compatibility allowlist, schema v1 (proposed)",
  "type": "object",
  "required": [
    "schemaVersion",
    "releaseTrain",
    "family",
    "allowedSelections"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "releaseTrain": {
      "const": "0.2.4"
    },
    "family": {
      "const": "0.2"
    },
    "allowedSelections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  },
  "additionalProperties": false
}
