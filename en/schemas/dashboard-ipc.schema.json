{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CIRNETRULES local stdio protocol",
  "$defs": {
    "requestId": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,96}$"},
    "readCancellation": {
      "description": "The result of a request.cancel response. The target read also completes once on its original ID.",
      "type": "object", "additionalProperties": false, "required": ["state"],
      "properties": {
        "state": {"enum": ["CANCELLED", "CANCELLATION_REQUESTED", "NOT_PENDING"]}
      }
    },
    "recordId": {"type": "string", "pattern": "^[1-9][0-9]{0,18}$"},
    "pageCursor": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,18})$"},
    "mutationKey": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$"},
    "operationId": {"type": "string", "pattern": "^operation-[0-9a-f]{16}-[1-9][0-9]{0,19}$"},
    "backupName": {"type": "string", "pattern": "^snapshot-[0-9A-Fa-f]{32}\\.sqlite3$"},
    "count": {"type": "integer", "minimum": 0},
    "runtimeError": {
      "type": "object", "additionalProperties": false, "required": ["code", "message"],
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"},
        "details": {"type": "object"}
      }
    },
    "governanceAssetId": {"type": "string", "pattern": "^asset-[0-9a-f]{32}$"},
    "governanceRevision": {"type": "integer", "minimum": 1},
    "governanceKind": {"enum": ["rule", "skill", "profile", "reference", "policy", "command", "hook"]},
    "governanceFormat": {"enum": ["markdown", "json", "yaml"]},
    "governanceExpected": {
      "type": "object", "required": ["id", "expected_revision"],
      "properties": {
        "id": {"$ref": "#/$defs/governanceAssetId"},
        "expected_revision": {"$ref": "#/$defs/governanceRevision"}
      }
    },
    "governanceMutation": {
      "allOf": [{"$ref": "#/$defs/governanceExpected"}],
      "required": ["mutation_key"],
      "properties": {"mutation_key": {"$ref": "#/$defs/mutationKey"}}
    },
    "governanceFiles": {
      "type": "array", "maxItems": 100, "items": {
        "type": "object", "required": ["path", "content"], "additionalProperties": false,
        "properties": {"path": {"type": "string", "maxLength": 240}, "content": {"type": "string"}}
      }
    },
    "governanceDependencies": {
      "type": "array", "maxItems": 32, "uniqueItems": true,
      "items": {"$ref": "#/$defs/governanceAssetId"}
    },
    "governanceBundle": {
      "type": "object", "additionalProperties": false,
      "required": ["bundle_version", "kind", "slug", "title", "revision", "digest", "document"],
      "properties": {
        "bundle_version": {"const": 1},
        "kind": {"$ref": "#/$defs/governanceKind"},
        "slug": {"type": "string", "maxLength": 64},
        "title": {"type": "string", "maxLength": 160},
        "revision": {"$ref": "#/$defs/governanceRevision"},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_name": {"type": ["string", "null"], "maxLength": 160},
        "document": {
          "type": "object", "additionalProperties": false,
          "required": ["en", "vi", "format", "description", "files", "dependencies"],
          "properties": {
            "en": {"type": "string"}, "vi": {"type": "string"},
            "format": {"$ref": "#/$defs/governanceFormat"},
            "description": {"type": "string", "maxLength": 600},
            "files": {"$ref": "#/$defs/governanceFiles"},
            "dependencies": {"$ref": "#/$defs/governanceDependencies"}
          }
        }
      }
    },
    "storageOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "kind", "state", "progress", "result", "error"],
      "properties": {
        "operation_id": {"$ref": "#/$defs/operationId"},
        "kind": {"enum": ["SCAN", "BACKUP", "VERIFY", "COMPACT"]},
        "state": {"enum": ["QUEUED", "RUNNING", "CANCEL_REQUESTED", "CANCELLED", "SUCCEEDED", "FAILED"]},
        "progress": {
          "type": "object", "additionalProperties": false, "required": ["phase", "completed", "total"],
          "properties": {
            "phase": {"enum": ["QUEUED", "MEASURE_FILES", "MEASURE_SQLITE", "COPY_PAGES", "VERIFY_SNAPSHOT", "VERIFY_SQLITE", "CHECK_MAINTENANCE", "COMPACT_SQLITE"]},
            "completed": {"$ref": "#/$defs/count"},
            "total": {"oneOf": [{"$ref": "#/$defs/count"}, {"type": "null"}]}
          }
        },
        "result": {"type": ["object", "null"]},
        "error": {"oneOf": [{"$ref": "#/$defs/runtimeError"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "SUCCEEDED"}}},
          "then": {"properties": {"result": {"type": "object"}, "error": {"type": "null"}}}
        },
        {
          "if": {"properties": {"state": {"enum": ["FAILED", "CANCELLED"]}}},
          "then": {"properties": {"result": {"type": "null"}, "error": {"$ref": "#/$defs/runtimeError"}}}
        },
        {
          "if": {"properties": {"state": {"enum": ["QUEUED", "RUNNING", "CANCEL_REQUESTED"]}}},
          "then": {"properties": {"result": {"type": "null"}, "error": {"type": "null"}}}
        }
      ]
    },
    "repositoryLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["widths", "order", "sort_column", "sort_descending", "show_archived", "status"],
      "properties": {
        "widths": {
          "type": "array", "minItems": 5, "maxItems": 5,
          "items": {"type": "integer", "minimum": 48, "maximum": 4096}
        },
        "order": {
          "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0, "maximum": 4}
        },
        "sort_column": {"type": "integer", "minimum": -1, "maximum": 4},
        "sort_descending": {"type": "boolean"},
        "show_archived": {"type": "boolean"},
        "status": {"enum": ["all", "active", "missing", "inaccessible", "rebind", "archived"]},
        "selected_id": {"type": ["string", "null"], "pattern": "^(binding-[0-9a-f]{32})?$"},
        "scroll": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "horizontal_scroll": {"type": "integer", "minimum": 0, "maximum": 1000000}
      }
    },
    "desktopSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theme", "density", "text_scale", "sidebar_width", "sidebar_collapsed", "notification_level"],
      "properties": {
        "theme": {"enum": ["dark", "light", "system"]},
        "density": {"enum": ["comfortable", "compact"]},
        "text_scale": {"type": "integer", "minimum": 85, "maximum": 150},
        "appearance": {
          "type": "object",
          "additionalProperties": false,
          "if": {"properties": {"accent": {"const": "custom"}}, "required": ["accent"]},
          "then": {"required": ["custom_accent"]},
          "properties": {
            "accent": {"enum": ["cirnet", "cobalt", "green", "yellow", "pink", "orange", "purple", "white", "custom"]},
            "ui_font": {"enum": ["system", "monospace"]},
            "content_scale": {"oneOf": [{"const": 0}, {"type": "integer", "minimum": 85, "maximum": 150}]},
            "code_scale": {"oneOf": [{"const": 0}, {"type": "integer", "minimum": 85, "maximum": 150}]},
            "interface_px": {"$ref": "#/$defs/appearanceTextPixels"},
            "conversation_px": {"$ref": "#/$defs/appearanceTextPixels"},
            "code_px": {"$ref": "#/$defs/appearanceTextPixels"},
            "density_px": {"type": "integer", "minimum": 2, "maximum": 14},
            "background": {"$ref": "#/$defs/appearanceRgb"},
            "foreground": {"$ref": "#/$defs/appearanceRgb"},
            "custom_accent": {"$ref": "#/$defs/appearanceRgb"},
            "font_family": {
              "type": "string", "minLength": 1, "maxLength": 128,
              "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f](?:[^\\u0000-\\u001f\\u007f-\\u009f]*[^\\s\\u0000-\\u001f\\u007f-\\u009f])?$"
            },
            "language": {"enum": ["en", "vi", "zh_CN"]}
          }
        },
        "sidebar_width": {"type": "integer", "minimum": 210, "maximum": 360},
        "sidebar_collapsed": {"type": "boolean"},
        "reduced_motion": {"type": "boolean", "default": false},
        "repository_layout": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/repositoryLayout"}]},
        "notification_level": {"enum": ["all", "important"]}
      }
    },
    "appearanceTextPixels": {"type": "integer", "minimum": 10, "maximum": 26},
    "appearanceRgb": {"type": "string", "minLength": 7, "maxLength": 7, "pattern": "^#[0-9A-Fa-f]{6}$"},
    "preferencesResult": {
      "description": "Both preference methods return the normalized settings and current revision. Revision 0 is the initial default state.",
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "settings"],
      "properties": {
        "revision": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "settings": {"$ref": "#/$defs/desktopSettings"}
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "id",
        "method"
      ],
      "allOf": [
        {
          "if": {"properties": {"method": {"const": "cirnetrules.governance.asset.list"}}},
          "then": {"properties": {"params": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "kind": {"$ref": "#/$defs/governanceKind"},
              "search": {"type": "string", "maxLength": 120},
              "include_archived": {"type": "boolean"},
              "after": {"oneOf": [{"$ref": "#/$defs/governanceAssetId"}, {"type": "null"}]},
              "limit": {"type": "integer", "minimum": 1, "maximum": 100}
            }
          }}}
        },
        {
          "if": {"properties": {"method": {"const": "cirnetrules.governance.profile.list"}}},
          "then": {"properties": {"params": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "after": {"oneOf": [{"$ref": "#/$defs/governanceAssetId"}, {"type": "null"}]},
              "limit": {"type": "integer", "minimum": 1, "maximum": 100}
            }
          }}}
        },
        {
          "if": {"properties": {"method": {"const": "cirnetrules.governance.assignment.list"}}},
          "then": {"properties": {"params": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "binding_id": {"type": "string", "pattern": "^binding-[0-9a-f]{32}$"},
              "after": {"oneOf": [{"$ref": "#/$defs/governanceAssetId"}, {"type": "null"}]},
              "limit": {"type": "integer", "minimum": 1, "maximum": 100}
            }
          }}}
        },
        {
          "if": {"properties": {"method": {"const": "cirnetrules.governance.effective.preview"}}},
          "then": {"properties": {"params": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "binding_id": {"type": "string", "pattern": "^binding-[0-9a-f]{32}$"},
              "profile_id": {"$ref": "#/$defs/governanceAssetId"},
              "mode": {"enum": ["WORK", "VERIFY", "ACCEPT", "RELEASE", "AUDIT"]},
              "budget_bytes": {"type": "integer", "minimum": 1, "maximum": 220000}
            }
          }}}
        },
        {
          "if": {"properties": {"method": {"enum": ["cirnetrules.governance.revision.history", "cirnetrules.governance.change.history"]}}},
          "then": {"required": ["params"], "properties": {"params": {
            "type": "object", "additionalProperties": false, "required": ["id"],
            "properties": {
              "id": {"$ref": "#/$defs/governanceAssetId"},
              "before": {"$ref": "#/$defs/governanceRevision"},
              "limit": {"type": "integer", "minimum": 1, "maximum": 100}
            }
          }}}
        },
        {
          "if": {"properties": {"method": {"const": "cirnetrules.governance.revision.get"}}},
          "then": {"required": ["params"], "properties": {"params": {
            "type": "object", "additionalProperties": false, "required": ["id", "revision"],
            "properties": {
              "id": {"$ref": "#/$defs/governanceAssetId"},
              "revision": {"$ref": "#/$defs/governanceRevision"}
            }
          }}}
        },
        {
          "if": {"properties": {"method": {"enum": ["cirnetrules.governance.asset.get", "cirnetrules.governance.asset.export"]}}},
          "then": {"required": ["params"], "properties": {"params": {
            "type": "object", "required": ["id"], "additionalProperties": false,
            "properties": {"id": {"$ref": "#/$defs/governanceAssetId"}}
          }}}
        },
        {
          "if": {"properties": {"method": {"const": "cirnetrules.governance.asset.create"}}},
          "then": {"required": ["params"], "properties": {"params": {
            "type": "object", "required": ["kind", "slug", "title", "mutation_key"], "additionalProperties": false,
            "properties": {
              "kind": {"$ref": "#/$defs/governanceKind"},
              "slug": {"type": "string", "maxLength": 64},
              "title": {"type": "string", "maxLength": 160},
              "format": {"$ref": "#/$defs/governanceFormat"},
              "source_name": {"type": ["string", "null"], "maxLength": 160},
              "mutation_key": {"$ref": "#/$defs/mutationKey"}
            }
          }}}
        },
        {
          "if": {"properties": {"method": {"enum": ["cirnetrules.governance.asset.rename", "cirnetrules.governance.asset.duplicate"]}}},
          "then": {"required": ["params"], "properties": {"params": {
            "allOf": [{"$ref": "#/$defs/governanceMutation"}], "unevaluatedProperties": false,
            "required": ["slug", "title"],
            "properties": {"slug": {"type": "string", "maxLength": 64}, "title": {"type": "string", "maxLength": 160}}
          }}}
        },
        {
          "if": {"properties": {"method": {"const": "cirnetrules.governance.draft.save"}}},
          "then": {"required": ["params"], "properties": {"params": {
            "allOf": [{"$ref": "#/$defs/governanceMutation"}], "unevaluatedProperties": false,
            "required": ["en", "vi", "format"],
            "properties": {
              "title": {"type": "string", "maxLength": 160},
              "description": {"type": "string", "maxLength": 600},
              "en": {"type": "string"}, "vi": {"type": "string"},
              "format": {"$ref": "#/$defs/governanceFormat"},
              "files": {"$ref": "#/$defs/governanceFiles"},
              "dependencies": {"$ref": "#/$defs/governanceDependencies"}
            }
          }}}
        },
        {
          "if": {"properties": {"method": {"enum": ["cirnetrules.governance.draft.discard", "cirnetrules.governance.change.review", "cirnetrules.governance.asset.archive", "cirnetrules.governance.asset.restore", "cirnetrules.governance.asset.delete"]}}},
          "then": {"required": ["params"], "properties": {"params": {
            "allOf": [{"$ref": "#/$defs/governanceMutation"}], "unevaluatedProperties": false
          }}}
        },
        {
          "if": {"properties": {"method": {"enum": ["cirnetrules.governance.revision.validate", "cirnetrules.governance.revision.compare"]}}},
          "then": {"required": ["params"], "properties": {"params": {
            "allOf": [{"$ref": "#/$defs/governanceExpected"}], "unevaluatedProperties": false
          }}}
        },
        {
          "if": {"properties": {"method": {"const": "cirnetrules.governance.change.publish"}}},
          "then": {"required": ["params"], "properties": {"params": {
            "allOf": [{"$ref": "#/$defs/governanceMutation"}], "unevaluatedProperties": false,
            "required": ["review_token"], "properties": {"review_token": {"type": "string", "pattern": "^review-[0-9a-f]{32}$"}}
          }}}
        },
        {
          "if": {"properties": {"method": {"const": "cirnetrules.governance.change.rollback"}}},
          "then": {"required": ["params"], "properties": {"params": {
            "allOf": [{"$ref": "#/$defs/governanceMutation"}], "unevaluatedProperties": false,
            "required": ["target_revision"], "properties": {"target_revision": {"$ref": "#/$defs/governanceRevision"}}
          }}}
        },
        {
          "if": {"properties": {"method": {"const": "cirnetrules.governance.assignment.update"}}},
          "then": {"required": ["params"], "properties": {"params": {
            "allOf": [{"$ref": "#/$defs/governanceMutation"}], "unevaluatedProperties": false,
            "required": ["binding_id", "enabled"],
            "properties": {"binding_id": {"type": "string", "pattern": "^binding-[0-9a-f]{32}$"}, "enabled": {"type": "boolean"}}
          }}}
        },
        {
          "if": {"properties": {"method": {"const": "cirnetrules.governance.profile.default"}}},
          "then": {"required": ["params"], "properties": {"params": {
            "allOf": [{"$ref": "#/$defs/governanceMutation"}], "unevaluatedProperties": false,
            "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}}
          }}}
        },
        {
          "if": {"properties": {"method": {"const": "cirnetrules.governance.asset.import.preview"}}},
          "then": {"required": ["params"], "properties": {"params": {
            "type": "object", "additionalProperties": false, "required": ["bundle"],
            "properties": {"bundle": {"$ref": "#/$defs/governanceBundle"}}
          }}}
        },
        {
          "if": {"properties": {"method": {"const": "cirnetrules.governance.asset.import.apply"}}},
          "then": {"required": ["params"], "properties": {"params": {
            "type": "object", "additionalProperties": false, "required": ["bundle", "fingerprint", "mutation_key"],
            "properties": {
              "bundle": {"$ref": "#/$defs/governanceBundle"}, "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "mutation_key": {"$ref": "#/$defs/mutationKey"}, "slug": {"type": "string", "maxLength": 64}
            }
          }}}
        },
        {
          "if": {"properties": {"method": {"const": "cirnetrules.integration.list"}}},
          "then": {"properties": {"params": {"type": "object", "maxProperties": 0}}}
        },
        {
          "if": {"properties": {"method": {"const": "cirnetrules.integration.probe"}}},
          "then": {"required": ["params"], "properties": {"params": {
            "type": "object", "additionalProperties": false, "required": ["adapter", "port"],
            "properties": {
              "adapter": {"enum": ["openhands", "opencode"]},
              "port": {"type": "integer", "minimum": 1, "maximum": 65535}
            }
          }}}
        },
        {
          "if": {"properties": {"method": {"const": "cirnetrules.integration.import_preview"}}},
          "then": {"required": ["params"], "properties": {"params": {
            "type": "object", "additionalProperties": false, "required": ["format", "source"],
            "properties": {
              "format": {"enum": ["openhands-skill", "opencode-v1-agent", "opencode-v2-agent"]},
              "source": {"type": "string", "maxLength": 131072}
            }
          }}}
        },
        {
          "if": {"properties": {"method": {"const": "cirnetrules.preferences.get"}}},
          "then": {"properties": {"params": {"type": "object", "maxProperties": 0}}}
        },
        {
          "if": {"properties": {"method": {"const": "cirnetrules.preferences.set"}}},
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": ["expected_revision", "settings"],
                "properties": {
                  "expected_revision": {"type": "integer", "minimum": 0, "maximum": 2147483646},
                  "settings": {"$ref": "#/$defs/desktopSettings"}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"method": {"enum": ["cirnetrules.conversation.delete.preview", "cirnetrules.message.delete.preview", "cirnetrules.conversation.delete", "cirnetrules.message.delete", "cirnetrules.conversation.unarchive"]}}},
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "type": "object", "additionalProperties": false, "required": ["id"],
                "properties": {
                  "id": {"$ref": "#/$defs/recordId"},
                  "message_id": {"$ref": "#/$defs/recordId"},
                  "revision": {"type": "integer", "minimum": 1},
                  "token": {"type": "string", "minLength": 1, "maxLength": 512},
                  "key": {"$ref": "#/$defs/mutationKey"}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"method": {"enum": ["cirnetrules.message.delete.preview", "cirnetrules.message.delete"]}}},
          "then": {"properties": {"params": {"required": ["message_id"]}}}
        },
        {
          "if": {"properties": {"method": {"enum": ["cirnetrules.conversation.delete", "cirnetrules.message.delete"]}}},
          "then": {"properties": {"params": {"required": ["revision", "token", "key"]}}}
        },
        {
          "if": {"properties": {"method": {"const": "cirnetrules.conversation.unarchive"}}},
          "then": {"properties": {"params": {"required": ["revision"]}}}
        },
        {
          "if": {"properties": {"method": {"enum": ["cirnetrules.conversation.get", "cirnetrules.conversation.resume"]}}},
          "then": {"properties": {"params": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": {"$ref": "#/$defs/recordId"},
              "before": {"$ref": "#/$defs/pageCursor"},
              "after": {"$ref": "#/$defs/pageCursor"},
              "limit": {"type": "integer", "minimum": 1, "maximum": 100}
            },
            "not": {"required": ["before", "after"]}
          }}}
        },
        {
          "if": {"properties": {"method": {"const": "cirnetrules.automation.delete"}}},
          "then": {"required": ["params"], "properties": {"params": {
            "type": "object", "required": ["id", "revision"], "additionalProperties": false,
            "properties": {
              "id": {"$ref": "#/$defs/recordId"},
              "revision": {"type": "integer", "minimum": 1}
            }
          }}}
        },
        {
          "if": {"properties": {"method": {"const": "cirnetrules.request.cancel"}}},
          "then": {"required": ["params"], "properties": {"params": {
            "type": "object", "required": ["id"], "additionalProperties": false,
            "properties": {"id": {"$ref": "#/$defs/requestId"}}
          }}}
        },
        {
          "if": {"properties": {"method": {"enum": ["cirnetrules.operation.get", "cirnetrules.operation.cancel"]}}},
          "then": {"required": ["params"], "properties": {"params": {
            "type": "object", "required": ["operation_id"], "additionalProperties": false,
            "properties": {"operation_id": {"$ref": "#/$defs/operationId"}}
          }}}
        },
        {
          "if": {"properties": {"method": {"enum": ["cirnetrules.storage.chats", "cirnetrules.storage.scan", "cirnetrules.storage.backup", "cirnetrules.storage.backup.start"]}}},
          "then": {"properties": {"params": {"type": "object", "maxProperties": 0}}}
        },
        {
          "if": {"properties": {"method": {"enum": ["cirnetrules.storage.verify", "cirnetrules.storage.verify.start"]}}},
          "then": {"properties": {"params": {
            "type": "object", "additionalProperties": false,
            "properties": {"backup": {"oneOf": [{"$ref": "#/$defs/backupName"}, {"type": "null"}]}}
          }}}
        },
        {
          "if": {"properties": {"method": {"const": "cirnetrules.storage.compact.start"}}},
          "then": {"required": ["params"], "properties": {"params": {
            "type": "object", "additionalProperties": false,
            "required": ["expected_page_count", "expected_free_pages"],
            "properties": {
              "expected_page_count": {"$ref": "#/$defs/count"},
              "expected_free_pages": {"$ref": "#/$defs/count"}
            }
          }}}
        }
      ],
      "properties": {
        "v": {
          "const": 3
        },
        "id": {"$ref": "#/$defs/requestId"},
        "method": {
          "type": "string",
          "pattern": "^cirnetrules\\.[A-Za-z0-9_.-]{1,84}$"
        },
        "params": {
          "type": "object"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "id",
        "ok",
        "result"
      ],
      "if": {"properties": {"result": {"type": "object", "required": ["operation_id"]}}},
      "then": {"properties": {"result": {"$ref": "#/$defs/storageOperation"}}},
      "properties": {
        "v": {
          "const": 3
        },
        "id": {
          "type": "string"
        },
        "ok": {
          "const": true
        },
        "result": {
          "properties": {
            "read_cancellation": {
              "description": "runtime.info capability for request.cancel on this connection.",
              "const": true
            },
            "conversation_event_watermark": {
