{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CGACP local stdio protocol",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "id",
        "method"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,96}$"
        },
        "method": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,96}$"
        },
        "params": {
          "type": "object"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "id",
        "ok",
        "result"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "type": "string"
        },
        "ok": {
          "const": true
        },
        "result": {}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "id",
        "ok",
        "error"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "type": "string"
        },
        "ok": {
          "const": false
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      }
    }
  ]
}
