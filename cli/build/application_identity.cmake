cmake_minimum_required(VERSION 3.24)

set(identity_manifest "${CMAKE_CURRENT_LIST_DIR}/../../application-identity.json")
file(READ "${identity_manifest}" identity_json)
foreach(field IN ITEMS product_id display_name organization repository ipc_protocol)
    string(JSON identity_${field} GET "${identity_json}" "${field}")
endforeach()
if(NOT identity_product_id MATCHES "^[a-z][a-z0-9]*$")
    message(FATAL_ERROR "Invalid product ID in application-identity.json")
endif()
string(TOUPPER "${identity_product_id}" identity_symbol)

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "${identity_product_id}")
endif()
