{
  "version": 6,
  "configurePresets": [
    {
      "name": "desktop",
      "displayName": "OPENRULES desktop",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/desktop",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [{"name": "desktop", "configurePreset": "desktop"}],
  "testPresets": [
    {"name": "desktop", "configurePreset": "desktop", "output": {"outputOnFailure": true}}
  ]
}
