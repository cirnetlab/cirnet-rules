QWidget { font-family: "@UI_FAMILY@"; }
QMainWindow, QWidget#content, QStackedWidget#pages { background: @CANVAS@; }
QFrame#sidebar { background: @RAIL@; }
QFrame#sidebarFooter { border-top: 1px solid @BORDER@; }
QFrame#settingsSidebar { background: @RAIL@; border-right: 1px solid @BORDER@; }
QFrame#settingsGroup, QFrame#settingsCard, QFrame#storageDatabaseActions,
QFrame#storageBackupActions, QFrame[role="settingsCard"] {
    background: @SURFACE@; border: 1px solid @BORDER@; border-radius: 16px;
}
QFrame#settingsSeparator { border: 0; background: @BORDER@; }
QFrame#appearanceSwatch { background: @BASE@; border: 1px solid @BORDER@; border-radius: 13px; }
QSplitter::handle { background: @CANVAS@; border-left: 1px solid @BORDER@; }
QSplitter::handle:hover, QSplitter::handle:pressed { background: @ACCENT@; }
QLabel, QAbstractButton, QLineEdit, QPlainTextEdit, QComboBox, QAbstractItemView,
QAbstractSpinBox, QMenu { color: @TEXT@; }
QLabel#brand { font-size: @SECTION_SIZE@px; font-weight: 750; }
QLabel#brandSubtitle, QLabel#eyebrow { color: @MUTED@; font-size: @META_SIZE@px; font-weight: 650; }
QLabel#heading { font-size: @TITLE_SIZE@px; font-weight: 700; }
QLabel#sectionTitle, QLabel#automationCardTitle { font-size: @SECTION_SIZE@px; font-weight: 650; }
QLabel#lead, QLabel#cardBody { color: @MUTED@; }
QLabel#meta { color: @MUTED@; font-size: @META_SIZE@px; }
QLabel#appearanceContrastWarning { color: @WARNING@; font-size: @META_SIZE@px; }
QLabel#governanceStatus { color: @MUTED@; }
QLabel#governanceStatus[governanceError="true"] { color: @DANGER@; }
QPushButton#governanceImport { padding-right: 26px; }
QTabWidget#governanceSections::pane, QTabWidget#governanceEditorTabs::pane { border: 0; }
QWidget#configurationPage QTabBar::tab {
    background: transparent; color: @MUTED@; border: 1px solid transparent;
    border-radius: 9px; margin-right: 4px; padding: @VERTICAL_PAD@px 12px;
}
QWidget#configurationPage QTabBar::tab:hover { background: @HOVER@; }
QWidget#configurationPage QTabBar::tab:selected { background: @SELECTED@; color: @TEXT@; }
QWidget#configurationPage QTabBar::tab:focus { border-color: @ACCENT@; }
QFrame#card { background: @SURFACE@; border: 1px solid @BORDER@; border-radius: 14px; }
QFrame#toast { background: @SURFACE@; border: 1px solid @BORDER@; border-radius: 14px; }
QFrame#toast[severity="error"] { border-color: @DANGER@; }
QFrame#toast[severity="warning"] { border-color: @WARNING@; }
QLabel#chip, QLabel#mutedChip {
    color: @MUTED@; background: @HOVER@; border-radius: 8px; padding: 2px 6px; font-size: @META_SIZE@px;
}
QPushButton, QToolButton {
    background: transparent; border: 1px solid transparent; border-radius: 9px;
    padding: @VERTICAL_PAD@px 12px;
}
QToolButton { padding: @VERTICAL_PAD@px; }
QToolButton#dismissToast { padding: 0; }
QPushButton:hover, QToolButton:hover { background: @HOVER@; }
QPushButton:pressed, QToolButton:pressed { background: @SELECTED@; }
QPushButton:disabled, QToolButton:disabled { color: @MUTED@; background: transparent; }
QPushButton[actionRole="secondary"], QToolButton[actionRole="secondary"] {
    background: @SURFACE@; border-color: @BORDER@; font-weight: 600;
}
QPushButton[actionRole="secondary"]:hover, QToolButton[actionRole="secondary"]:hover { background: @HOVER@; }
QPushButton[actionRole="secondary"]:pressed, QToolButton[actionRole="secondary"]:pressed { background: @SELECTED@; }
QPushButton[actionRole="secondary"]:disabled, QToolButton[actionRole="secondary"]:disabled { background: transparent; }
QWidget#storagePage QPushButton[actionRole="secondary"]:disabled {
    background: @BASE@; border-color: @BORDER@; color: @MUTED@;
}
QPushButton#storageMaintenanceToggle { text-align: left; padding-left: 14px; }
QPushButton#storageMaintenanceToggle:checked { background: @SELECTED@; }
QWidget#storagePage QProgressBar {
    background: @BASE@; border: 1px solid @BORDER@; border-radius: 7px;
    min-height: 13px; text-align: center; color: @TEXT@;
}
QWidget#storagePage QProgressBar::chunk { background: @PRIMARY@; border-radius: 6px; }
QPushButton[actionRole="danger"], QToolButton[actionRole="danger"] { color: @DANGER@; }
QPushButton[primary="true"] { color: @ON_ACCENT@; background: @PRIMARY@; font-weight: 650; }
QPushButton[primary="true"]:hover { color: @ON_ACCENT@; background: @PRIMARY_HOVER@; }
QPushButton[primary="true"]:pressed { color: @ON_ACCENT@; background: @PRIMARY_PRESSED@; }
QPushButton[primary="true"]:disabled { color: @MUTED@; background: @SURFACE@; }
QPushButton[navigation="true"], QToolButton[navigation="true"] {
    background: transparent; border-color: transparent; text-align: left;
}
QPushButton[navigation="true"]:checked, QToolButton[navigation="true"]:checked { background: @SELECTED@; }
QPushButton[navigation="true"]:hover:!checked, QToolButton[navigation="true"]:hover:!checked { background: @HOVER@; }
QPushButton[navigation="true"]:pressed:!checked, QToolButton[navigation="true"]:pressed:!checked { background: @SELECTED@; }
QPushButton::menu-indicator, QToolButton::menu-indicator {
    subcontrol-origin: padding; subcontrol-position: center right; width: 16px; height: 12px;
}
QToolButton#addRepository, QToolButton#repoActions { padding-right: 22px; }
QLineEdit, QPlainTextEdit {
    border: 1px solid @BORDER@; border-radius: 9px; background: @BASE@;
    padding: @VERTICAL_PAD@px; selection-background-color: @PRIMARY@; selection-color: @ON_ACCENT@;
}
QLineEdit[clearButtonEnabled="true"], QLineEdit[searchField="true"] {
    border-color: transparent; background: @HOVER@;
}
QLineEdit[searchField="true"] {
    border: 1px solid @BORDER@; border-radius: 14px; min-height: 24px;
    padding-left: 8px; padding-right: 8px;
}
QLineEdit:focus, QPlainTextEdit:focus,
QPushButton[keyboardFocusVisible="true"]:focus, QToolButton[keyboardFocusVisible="true"]:focus {
    border-color: @ACCENT@;
}
QAbstractSpinBox QLineEdit, QComboBox QLineEdit {
    border: 0; padding: 0; background: transparent; selection-background-color: @PRIMARY@; selection-color: @ON_ACCENT@;
}
QLineEdit QToolButton { padding: 0; }
QPlainTextEdit#conversationTranscript { background: @CANVAS@; border-color: transparent; }
QPlainTextEdit#conversationComposer { background: @COMPOSER@; }
QAbstractItemView#conversationTranscript, QPlainTextEdit#conversationTranscript,
QPlainTextEdit#conversationComposer { font-size: @CONTENT_SIZE@px; }
QPlainTextEdit[codeText="true"] { font-size: @CODE_SIZE@px; font-family: "@CODE_FAMILY@"; }
QToolButton#localStatus, QToolButton#navSettings {
    background: transparent; border-color: transparent;
    color: @MUTED@; font-size: @META_SIZE@px; padding: 4px 5px;
}
QToolButton#localStatus:hover, QToolButton#navSettings:hover { background: @HOVER@; color: @TEXT@; }
QToolButton#navSettings:pressed { background: @SELECTED@; }
QToolButton#navSettings:checked { background: @SELECTED@; }
QToolButton#localStatus[keyboardFocusVisible="true"]:focus,
QToolButton#navSettings[keyboardFocusVisible="true"]:focus { border-color: @ACCENT@; }
QCheckBox, QRadioButton { spacing: 7px; padding: 3px; border: 1px solid transparent; border-radius: 4px; }
QCheckBox[keyboardFocusVisible="true"]:focus, QRadioButton[keyboardFocusVisible="true"]:focus { border-color: @ACCENT@; }
QTableView, QListWidget { border: 0; background: @BASE@; selection-background-color: @SELECTED@; selection-color: @TEXT@; }
QAbstractItemView::item { padding: @VERTICAL_PAD@px; }
QAbstractItemView::item:hover:!selected { background: @HOVER@; }
QAbstractItemView::item:selected { background: @SELECTED@; color: @TEXT@; }
QAbstractItemView[keyboardFocusVisible="true"]::item:focus { outline: 1px solid @ACCENT@; }
QListWidget#conversationList, QListWidget#settingsNavigation { background: transparent; padding: 0; }
QListWidget#conversationList::item, QListWidget#settingsNavigation::item { border-radius: 8px; }
QListWidget#settingsNavigation::item { padding: @VERTICAL_PAD@px 8px; }
QListWidget#settingsNavigation::item:selected { font-weight: 650; }
QTableView[dataTable="true"] {
    border: 1px solid @BORDER@; alternate-background-color: @ALTERNATE_ROW@;
}
QTableView[dataTable="true"]::item { padding: @VERTICAL_PAD@px 10px; }
QTableView[dataTable="true"]::item:hover:!selected { background: @TABLE_HOVER@; }
QTableView[dataTable="true"]::item:selected { background: @TABLE_SELECTED@; color: @TEXT@; }
QTableView[dataTable="true"] QHeaderView { background: @TABLE_HEADER@; border-bottom: 1px solid @BORDER@; }
QTableView[dataTable="true"] QHeaderView::section {
    background: @TABLE_HEADER@; color: @TEXT@; font-weight: 600;
    border: 0; padding: @TABLE_HEADER_PAD@px 10px;
}
QDialog, QMessageBox, QMenu, QComboBox QAbstractItemView { background: @SURFACE@; }
QMenu, QComboBox QAbstractItemView { border: 1px solid @CONTROL@; }
QMenu::item:selected { color: @TEXT@; background: @SELECTED@; }
QScrollArea { border: 0; background: @CANVAS@; }
QScrollBar:vertical { background: transparent; width: 10px; }
QScrollBar:horizontal { background: transparent; height: 10px; }
QScrollBar::handle { background: transparent; min-width: 24px; min-height: 24px; border-radius: 3px; }
QScrollBar::handle:vertical { margin: 0 2px; }
QScrollBar::handle:horizontal { margin: 2px 0; }
QScrollBar[scrollRevealed="true"]::handle { background: @SCROLL_THUMB@; }
QScrollBar[scrollRevealed="true"]::handle:hover, QScrollBar::handle:pressed { background: @ACCENT@; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QToolTip { color: @TEXT@; background: @SURFACE@; border: 1px solid @CONTROL@; padding: 4px; }
