QMainWindow, QWidget#content, QStackedWidget#pages { background: @CANVAS@; }
QFrame#sidebar { background: @RAIL@; }
QFrame#sidebarFooter { border-top: 1px solid @BORDER@; }
QFrame#settingsSidebar { background: @RAIL@; border-right: 1px solid @BORDER@; }
QFrame#settingsGroup { background: @SURFACE@; border: 1px solid @BORDER@; border-radius: 8px; }
QFrame#settingsSeparator { border: 0; background: @BORDER@; }
QSplitter::handle { background: @CANVAS@; border-left: 1px solid @BORDER@; }
QSplitter::handle:hover, QSplitter::handle:pressed { background: @ACCENT@; }
QLabel, QAbstractButton, QLineEdit, QPlainTextEdit, QComboBox, QAbstractItemView,
QAbstractSpinBox, QMenu { color: @TEXT@; font-size: @BODY_SIZE@px; }
QLabel#brand { font-size: @SECTION_SIZE@px; font-weight: 750; }
QLabel#brandSubtitle, QLabel#eyebrow { color: @MUTED@; font-size: @META_SIZE@px; font-weight: 650; }
QLabel#heading { font-size: @TITLE_SIZE@px; font-weight: 700; }
QLabel#sectionTitle, QLabel#automationCardTitle { font-size: @SECTION_SIZE@px; font-weight: 650; }
QLabel#lead, QLabel#cardBody { color: @MUTED@; }
QLabel#meta { color: @MUTED@; font-size: @META_SIZE@px; }
QFrame#card { background: @SURFACE@; border: 1px solid @BORDER@; border-radius: 8px; }
QFrame#toast { background: @SURFACE@; border: 1px solid @BORDER@; border-radius: 10px; }
QFrame#toast[severity="error"] { border-color: @DANGER@; }
QFrame#toast[severity="warning"] { border-color: @WARNING@; }
QLabel#chip, QLabel#mutedChip {
    color: @MUTED@; background: @HOVER@; border-radius: 4px; padding: 2px 6px; font-size: @META_SIZE@px;
}
QPushButton, QToolButton {
    background: transparent; border: 1px solid transparent; border-radius: 6px;
    padding: @VERTICAL_PAD@px 10px;
}
QToolButton { padding: @VERTICAL_PAD@px; }
QToolButton#dismissToast { padding: 0; }
QPushButton:hover, QToolButton:hover { background: @HOVER@; }
QPushButton:pressed, QToolButton:pressed { background: @SELECTED@; }
QPushButton:disabled, QToolButton:disabled { color: @MUTED@; background: transparent; }
QPushButton[primary="true"] { color: @ON_ACCENT@; background: @ACCENT@; font-weight: 650; }
QPushButton[primary="true"]:hover { color: @ON_ACCENT@; background: @PRIMARY_HOVER@; }
QPushButton[primary="true"]:pressed { color: @ON_ACCENT@; background: @PRIMARY_PRESSED@; }
QPushButton[primary="true"]:disabled { color: @MUTED@; background: @SURFACE@; }
QPushButton[navigation="true"], QToolButton[navigation="true"] {
    background: transparent; border-color: transparent; text-align: left;
}
QPushButton[navigation="true"]:checked, QToolButton[navigation="true"]:checked { background: @SELECTED@; }
QPushButton[navigation="true"]:hover:!checked, QToolButton[navigation="true"]:hover:!checked { background: @HOVER@; }
QPushButton[navigation="true"]:pressed:!checked, QToolButton[navigation="true"]:pressed:!checked { background: @SELECTED@; }
QPushButton::menu-indicator, QToolButton::menu-indicator {
    subcontrol-origin: padding; subcontrol-position: center right; width: 16px; height: 12px;
}
QToolButton#addRepository, QToolButton#repoActions { padding-right: 22px; }
QLineEdit, QPlainTextEdit {
    border: 1px solid @BORDER@; border-radius: 6px; background: @BASE@;
    padding: @VERTICAL_PAD@px; selection-background-color: @SELECTED@; selection-color: @TEXT@;
}
QLineEdit[clearButtonEnabled="true"], QLineEdit[searchField="true"] {
    border-color: transparent; background: @HOVER@;
}
QLineEdit:focus, QPlainTextEdit:focus,
QPushButton[keyboardFocusVisible="true"]:focus, QToolButton[keyboardFocusVisible="true"]:focus {
    border-color: @ACCENT@;
}
QAbstractSpinBox QLineEdit, QComboBox QLineEdit {
    border: 0; padding: 0; background: transparent; selection-background-color: @SELECTED@; selection-color: @TEXT@;
}
QLineEdit QToolButton { padding: 0; }
QPlainTextEdit#conversationTranscript { border-color: transparent; }
QToolButton#localStatus, QToolButton#navSettings {
    background: transparent; border-color: transparent;
    color: @MUTED@; font-size: @META_SIZE@px; padding: 4px 5px;
}
QToolButton#localStatus:hover, QToolButton#navSettings:hover { background: @HOVER@; color: @TEXT@; }
QToolButton#navSettings:pressed { background: @SELECTED@; }
QToolButton#navSettings:checked { background: @SELECTED@; }
QToolButton#localStatus[keyboardFocusVisible="true"]:focus,
QToolButton#navSettings[keyboardFocusVisible="true"]:focus { border-color: @ACCENT@; }
QCheckBox, QRadioButton { spacing: 7px; padding: 3px; border: 1px solid transparent; border-radius: 4px; }
QCheckBox[keyboardFocusVisible="true"]:focus, QRadioButton[keyboardFocusVisible="true"]:focus { border-color: @ACCENT@; }
QTableView, QListWidget { border: 0; background: @BASE@; selection-background-color: @SELECTED@; selection-color: @TEXT@; }
QAbstractItemView::item { padding: @VERTICAL_PAD@px; }
QAbstractItemView::item:hover:!selected { background: @HOVER@; }
QAbstractItemView::item:selected { background: @SELECTED@; color: @TEXT@; }
QAbstractItemView[keyboardFocusVisible="true"]::item:focus { outline: 1px solid @ACCENT@; }
QListWidget#conversationList, QListWidget#settingsNavigation { background: transparent; padding: 0; }
QListWidget#conversationList::item, QListWidget#settingsNavigation::item { border-radius: 5px; }
QHeaderView { background: @SURFACE@; }
QHeaderView::section { background: @SURFACE@; color: @TEXT@; border: 0; padding: @VERTICAL_PAD@px 8px; }
QTableView { alternate-background-color: @SURFACE@; }
QDialog, QMessageBox, QMenu, QComboBox QAbstractItemView { background: @SURFACE@; }
QMenu, QComboBox QAbstractItemView { border: 1px solid @CONTROL@; }
QMenu::item:selected { background: @SELECTED@; }
QScrollArea { border: 0; background: @CANVAS@; }
QScrollBar:vertical { background: @BASE@; width: 10px; }
QScrollBar:horizontal { background: @BASE@; height: 10px; }
QScrollBar::handle { background: @CONTROL@; min-width: 24px; min-height: 24px; border-radius: 4px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QToolTip { color: @TEXT@; background: @SURFACE@; border: 1px solid @CONTROL@; padding: 4px; }
